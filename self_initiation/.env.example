# Copy to .env for local development. Never commit .env.

FLASK_SECRET_KEY=change-me
# Blank = local SQLite file. On Render this comes from the linked Postgres database.
DATABASE_URL=
# Local http only. Leave unset (true) in production so the page works inside the website iframe.
SESSION_COOKIE_SECURE=false

# Document reading (same key as the private valuations tool)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Solvit job creation. Use the credentials of the "Self-Initiate" broker alias,
# so every job this tool creates is attributed to that broker.
# Staging: https://solvit.staging9.com   Production: https://login.solvit.limited
SOLVIT_BASE_URL=https://solvit.staging9.com
# Only set this to override the default <SOLVIT_BASE_URL>/api/insurance-login
SOLVIT_AUTH_URL=
SOLVIT_USERNAME=
SOLVIT_PASSWORD=
# Only set this to override the default <SOLVIT_BASE_URL>/api/request/schedule-initiate-request
SOLVIT_API_URL=
SOLVIT_PAYMENT_TYPE=1

# Loaded once into an empty database on startup. Staging list: data/insurers_staging.csv.
# For production, leave blank and import the production master .xlsx in /admin/insurers.
INSURERS_SEED_FILE=data/insurers_staging.csv

# Optional Google Places key for the location search box (same as the private tool)
GEOPLACES_API_KEY=

# Letter must be dated within this many days
LETTER_MAX_AGE_DAYS=90

# Internal review pages at /admin
ADMIN_PASSWORD=
# Base URL put into the Solvit job comment so the back office can open the documents
PUBLIC_BASE_URL=http://localhost:5000
# Sites allowed to embed the page in an iframe, space separated, e.g. https://solvit.co.ke
FRAME_ANCESTORS=*
